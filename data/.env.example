# ---------------------------------------------------------------------------
# My-Money — the single configuration file.
#
# This is the one file a server operator needs to edit. Everything else that
# must survive a redeploy (the database, uploads, collected static files) lives
# in this `data/` folder alongside it. See data/README.md.
#
# NEVER commit this file. It is listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# PRODUCTION: replace this with a fresh key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Copy this file to `.env` and fill in a real key. Never commit `.env`.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Local development runs with DEBUG on. docker-compose forces it off, so the
# container never serves a debug page even though this line says True.
DJANGO_DEBUG=True

# Hostnames Django will answer for. Comma-separated. In Docker, nginx forwards
# the original Host header, so this must contain the name users actually type.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Where persistent data lives -------------------------------------------
# Relative to the repository root. The Docker images mount this at /data.
MY_MONEY_DATA_DIR=data

# --- Database --------------------------------------------------------------
# SQLite only, per the project decision. DB_NAME is a filename and always
# resolves inside <MY_MONEY_DATA_DIR>/db/. An absolute path is honoured too,
# which is the escape hatch if the file is mounted from elsewhere.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# WAL lets readers proceed while a writer is active, which matters once
# gunicorn runs more than one worker. Set to "delete" to restore the SQLite
# default.
SQLITE_JOURNAL_MODE=WAL

# PostgreSQL is not used, but the seam exists so no app code assumes SQLite:
#   DB_ENGINE=postgresql
#   DB_NAME=my_money
#   DB_USER=my_money
#   DB_PASSWORD=secret
#   DB_HOST=db
#   DB_PORT=5432

# --- Origins ---------------------------------------------------------------
# In Docker the SPA and the API share one origin (nginx serves both), so these
# are only needed if you expose the API on a separate host or port.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- Token lifetimes -------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Transport security ----------------------------------------------------
# Set this to True ONLY when the site is served over HTTPS. Left False here
# because the shipped compose file serves plain HTTP on port 80; turning it on
# without TLS in front causes an infinite redirect loop.
SECURE_SSL_REDIRECT=False

# --- Container tuning (ignored outside Docker) -----------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
